{
  "name": "shoe-order-manager",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "db:generate": "pnpm --filter @repo/db generate",
    "db:migrate": "pnpm --filter @repo/db migrate",
    "db:seed": "pnpm --filter @repo/db seed",
    "db:studio": "pnpm --filter @repo/db studio",
    "db:seed:demo": "pnpm --filter @repo/db seed:demo"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1",
    "prettier": "^3.4.2",
    "turbo": "^2.5.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@swc/core",
      "unrs-resolver",
      "@parcel/watcher"
    ]
  }
}
