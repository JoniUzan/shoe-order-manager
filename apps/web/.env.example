# Local development (docker compose up -d): the same URL twice.
DATABASE_URL="postgresql://postgres@localhost:5432/shoe_order_manager"
DIRECT_URL="postgresql://postgres@localhost:5432/shoe_order_manager"

# Neon: DATABASE_URL = the pooled host (`-pooler`) with `?sslmode=verify-full`, see
# packages/db/.env.example. On serverless hosting, also cap each instance's pg pool
# (default 10 connections; what `connection_limit=1` did under Prisma 6):
# DATABASE_POOL_MAX=1

# openssl rand -base64 33. Better Auth signs its cookies with it.
AUTH_SECRET=""
# In production, the site's own URL (https://...). Locally leave it unset: Better Auth
# then takes the origin from each request, so dev (:3000) and e2e (:3100) both work.
# BETTER_AUTH_URL=""

# Product images (ADR 0008): any S3 API. Locally the `storage` service from docker compose,
# which takes any key pair. Leave S3_BUCKET empty to run without images.
S3_ENDPOINT="http://localhost:8333"
S3_REGION="auto"
S3_BUCKET="product-images"
S3_ACCESS_KEY_ID="local"
S3_SECRET_ACCESS_KEY="local"
# Where browsers load the images from: the bucket's public URL, no trailing slash.
IMAGE_BASE_URL="http://localhost:8333/product-images"

# Cloudflare R2: S3_ENDPOINT="https://<account id>.r2.cloudflarestorage.com", an R2 API token's
# key pair (Object Read & Write on this bucket), and IMAGE_BASE_URL = the bucket's public r2.dev
# (later images.<domain>) address. Try the values with `pnpm storage:check --env <file>` first.

# Sentry (errors only). Leave unset locally: Sentry stays off. Production builds get it from
# the GitHub `production` environment (deploy.yml), not from here.
# NEXT_PUBLIC_SENTRY_DSN=""
