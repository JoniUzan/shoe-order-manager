# Local development (docker compose up -d): the same URL twice.
DATABASE_URL="postgresql://postgres@localhost:5432/shoe_order_manager"
DIRECT_URL="postgresql://postgres@localhost:5432/shoe_order_manager"

# Supabase: DATABASE_URL = transaction pooler (port 6543) with `?sslmode=no-verify`, see
# packages/db/.env.example. On serverless hosting, also cap each instance's pg pool
# (default 10 connections; what `connection_limit=1` did under Prisma 6):
# DATABASE_POOL_MAX=1

# openssl rand -base64 33
AUTH_SECRET=""
AUTH_TRUST_HOST=true
