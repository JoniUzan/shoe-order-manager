// ---------------------------------------------------------------------------
// Better Auth models (ADR 0009); field names are the ones it expects
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  // The chosen avatar as a token (`orb:onyx`); null → the orb generated
  // from the email. Better Auth's column, reused.
  image         String?
  passwordHash  String?
  locale        String    @default("he") // "he" | "en"
  theme         String    @default("system") // "light" | "dark" | "system"
  // When the welcome dialog was finished. Set explicitly, not derived from the
  // business name, so clearing the name later doesn't reopen onboarding.
  onboardedAt   DateTime?

  // Business details, printed on the invoice and the WhatsApp message.
  businessName    String?
  businessPhone   String?
  businessAddress String?
  businessTaxId   String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  customers   Customer[]
  shoeModels  ShoeModel[]
  orders      Order[]
  payments    Payment[]
}

// How a User signs in: one row per method. Email + password is the
// `credential` provider, with the password hash in `password`.
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One signed-in device. The web app holds `token` in a cookie; a mobile app
// will send it as a bearer token (ADR 0010).
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Short-lived tokens (password reset, once it exists).
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Better Auth's rate-limit counters, one row per IP and endpoint. In Postgres,
// not in memory: serverless instances don't share memory.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

// One row per sign-up attempt, for the per-IP rate limit. In Postgres, not in
// memory: serverless instances don't share memory. Old rows are deleted in
// app code (`actions/signup.ts`), not by a DB job.
model SignupAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}
