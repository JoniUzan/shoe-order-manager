// Shoe Order Manager — Prisma schema
// v1 datasource is SQLite; kept portable (no triggers, no generated columns,
// no DB-side UUIDs, no DB date functions) so a later swap to Turso/libSQL is
// a one-line datasource change. Money is stored as INTEGER agorot.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) models — Prisma adapter
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  locale        String    @default("he") // "he" | "en"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  customers   Customer[]
  shoeModels  ShoeModel[]
  orders      Order[]
  payments    Payment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain models
// ---------------------------------------------------------------------------

// Extensible status lookup — add stages (new / in_production / ready / delivered)
// later by inserting rows, never by altering an enum.
model OrderStatus {
  code       String  @id
  labelEn    String
  labelHe    String
  sortOrder  Int     @default(0)
  isTerminal Boolean @default(false)

  orders Order[]
}

model Customer {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  contactName String?
  phone       String?
  address     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner  User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([ownerId])
}

model ShoeModel {
  id                String   @id @default(cuid())
  ownerId           String
  name              String
  sku               String?
  description       String?
  defaultPriceAgorot Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([ownerId])
}

model Order {
  id            String   @id @default(cuid())
  ownerId       String
  customerId    String
  // Human-friendly running number, assigned per-owner in the create action
  // (SQLite can't autoincrement a non-id column; app assignment is portable).
  orderNumber   Int
  statusCode    String   @default("not_done")
  isCustomOrder Boolean  @default(false)
  notes         String?
  // Money in agorot (integer minor units). balance = totalAgorot - depositAgorot
  // is computed in app code, not stored.
  totalAgorot   Int      @default(0)
  depositAgorot Int      @default(0)
  paymentStatus String   @default("unpaid") // "unpaid" | "partial" | "paid"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner    User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status   OrderStatus @relation(fields: [statusCode], references: [code])
  items    OrderItem[]
  payments Payment[]

  @@unique([ownerId, orderNumber])
  @@index([ownerId])
  @@index([customerId])
  @@index([statusCode])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  // Catalog reference XOR free-text custom item — invariant enforced in the
  // Zod schema + Server Action (SQLite can't express a cross-column CHECK here).
  shoeModelId       String?
  customDescription String?
  size              String // text: supports "42", "42.5", "US 9"
  color             String?
  quantity          Int
  unitPriceAgorot   Int     @default(0)

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shoeModel ShoeModel? @relation(fields: [shoeModelId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Payment {
  id           String   @id @default(cuid())
  ownerId      String
  orderId      String
  amountAgorot Int
  paidAt       DateTime @default(now())
  method       String?
  note         String?

  owner User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([ownerId])
}
