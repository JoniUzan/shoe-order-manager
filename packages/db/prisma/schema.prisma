// Shoe Order Manager — Prisma schema
// Datasource is Postgres (Supabase in production, used as plain Postgres —
// no Supabase Auth, RLS or storage). Still kept portable (no triggers, no
// generated columns, no DB-side UUIDs, no DB date functions) so moving to any
// other Postgres host is a pg_dump + a new DATABASE_URL. Money is stored as
// INTEGER agorot.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection. On Supabase this is the pooled (transaction-mode,
  // port 6543) URL, which serverless hosting needs.
  url       = env("DATABASE_URL")
  // Direct (session, port 5432) connection for `prisma migrate` — migrations
  // can't run through a transaction-mode pooler. Locally, the same URL twice.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) models — Prisma adapter
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  locale        String    @default("he") // "he" | "en"
  theme         String    @default("system") // "light" | "dark" | "system"

  // Business details, printed on the invoice and the WhatsApp message.
  businessName    String?
  businessPhone   String?
  businessAddress String?
  businessTaxId   String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  customers   Customer[]
  shoeModels  ShoeModel[]
  orders      Order[]
  payments    Payment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain models
// ---------------------------------------------------------------------------

// Extensible status lookup — add stages (new / in_production / ready / delivered)
// later by inserting rows, never by altering an enum.
model OrderStatus {
  code       String  @id
  labelEn    String
  labelHe    String
  sortOrder  Int     @default(0)
  isTerminal Boolean @default(false)

  orders Order[]
}

model Customer {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  contactName String?
  phone       String?
  address     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner  User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([ownerId])
}

model ShoeModel {
  id                String   @id @default(cuid())
  ownerId           String
  name              String
  sku               String?
  description       String?
  defaultPriceAgorot Int?
  // The size run this model is ordered in, as a comma-separated list ordered
  // ascending ("36,37,38"). A String rather than an array column: it predates
  // the Postgres move, and a scalar keeps the schema portable.
  sizes             String?
  // Which sizing system those numbers belong to: "eu" | "us" | "uk". A label
  // only — every supported system is numeric, so it never changes what is a
  // valid size. Kept as a String rather than an enum to stay portable.
  sizeFormat        String   @default("eu")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items OrderItem[]
  packs SizePack[]

  @@index([ownerId])
}

// A pack (Hebrew: סדרה) a model is sold in: a fixed number of pairs per size,
// e.g. 38×3, 39×2, 40×3. No ownerId of its own — always reached through its
// owned ShoeModel (`shoeModel: { ownerId }`), never loaded by id alone.
model SizePack {
  id          String   @id @default(cuid())
  shoeModelId String
  name        String
  // Pairs per size, "38:3,39:2,40:3" — canonical form from serializeCurve in
  // @repo/domain. A string for the same reason as ShoeModel.sizes: it is only
  // ever read and written whole, and never searched by size.
  curve       String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shoeModel ShoeModel   @relation(fields: [shoeModelId], references: [id], onDelete: Cascade)
  packs     OrderPack[]

  @@index([shoeModelId])
}

model Order {
  id            String   @id @default(cuid())
  ownerId       String
  customerId    String
  // Human-friendly running number, assigned per-owner in the create action
  // (a per-owner sequence isn't expressible as autoincrement; app assignment
  // is portable). Concurrent creates are retried on the unique constraint.
  orderNumber   Int
  statusCode    String   @default("not_done")
  isCustomOrder Boolean  @default(false)
  notes         String?
  // Money in agorot (integer minor units). balance = totalAgorot - depositAgorot
  // is computed in app code, not stored.
  totalAgorot   Int      @default(0)
  depositAgorot Int      @default(0)
  paymentStatus String   @default("unpaid") // "unpaid" | "partial" | "paid"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner    User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status   OrderStatus @relation(fields: [statusCode], references: [code])
  items    OrderItem[]
  packs    OrderPack[]
  payments Payment[]

  @@unique([ownerId, orderNumber])
  @@index([ownerId])
  @@index([customerId])
  @@index([statusCode])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  // Catalog reference XOR free-text custom item — invariant enforced in the
  // Zod schema + Server Action (Prisma can't declare a cross-column CHECK).
  shoeModelId       String?
  customDescription String?
  size              String // text: supports "42", "42.5", "US 9"
  color             String?
  quantity          Int
  unitPriceAgorot   Int     @default(0)
  // Set when this size row is part of a pack taken on the order; null for
  // loose (extra) pairs. The row still carries its own quantity, so totals and
  // reports keep summing items and never need to know about packs.
  packId            String?

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shoeModel ShoeModel? @relation(fields: [shoeModelId], references: [id], onDelete: SetNull)
  pack      OrderPack? @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([packId])
}

// N packs taken on an order. Its pairs are ordinary OrderItem rows (one per
// size, quantity = count × pairs in the curve) pointing back here via packId.
// Name and curve are snapshots, so editing or deleting the catalog pack later
// never changes what an existing order says was sold.
model OrderPack {
  id         String  @id @default(cuid())
  orderId    String
  // The catalog pack it came from; SetNull if that pack is deleted later.
  sizePackId String?
  packName   String
  curve      String // pairs per pack, "38:3,39:2,40:3"
  count      Int // 1..999

  order    Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sizePack SizePack?   @relation(fields: [sizePackId], references: [id], onDelete: SetNull)
  items    OrderItem[]

  @@index([orderId])
}

model Payment {
  id           String   @id @default(cuid())
  ownerId      String
  orderId      String
  amountAgorot Int
  paidAt       DateTime @default(now())
  method       String?
  note         String?

  owner User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([ownerId])
}
