// Shoe Order Manager — Prisma schema
// Datasource is Postgres (Supabase in production, used as plain Postgres —
// no Supabase Auth, RLS or storage). Still kept portable (no triggers, no
// generated columns, no DB-side UUIDs, no DB date functions) so moving to any
// other Postgres host is a pg_dump + a new DATABASE_URL. Money is stored as
// INTEGER agorot.
//
// The schema is split across files (a Prisma multi-file schema): this file holds
// only the generator and datasource; the models live in models/*.prisma, one file
// per domain. prisma.config.ts points `schema` at this folder, so every .prisma
// file under it is loaded; migrations/ must stay next to this file.

// Generated into src/generated/prisma (gitignored); `@repo/db` re-exports it.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URLs live outside the schema since Prisma 7:
// - the CLI (migrate, studio, db seed) uses DIRECT_URL, set in prisma.config.ts —
//   migrations can't run through a transaction-mode pooler;
// - the app connects with DATABASE_URL through the pg driver adapter
//   (src/client.ts) — on Supabase, the transaction pooler (port 6543).
datasource db {
  provider = "postgresql"
}
