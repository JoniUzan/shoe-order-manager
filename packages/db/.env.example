# Loaded by prisma.config.ts (Prisma 7 no longer reads .env by itself) and by the seed scripts.
# DIRECT_URL: the Prisma CLI (migrate, studio, db seed). DATABASE_URL: the app's client (the seeds use it).
# Local development (docker compose up -d): the same URL twice.
DATABASE_URL="postgresql://postgres@localhost:5432/shoe_order_manager"
DIRECT_URL="postgresql://postgres@localhost:5432/shoe_order_manager"

# Neon (Project → Connect): the pooled host (`-pooler`) for the app, the direct host for the CLI.
# DATABASE_URL goes to node-postgres, not Prisma's engine: `pgbouncer=true` / `connection_limit` do
# nothing there, and `sslmode` keeps TLS on (Prisma 6 encrypted by default, pg does not).
# DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full"
# DIRECT_URL="postgresql://<user>:<password>@<endpoint>.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full"
